# Admin auth (Phase 2)
ADMIN_SECRET=changeme
ROOT_PASSWORD=changeme
# Storage (optional; without these, data is stored as local JSON / /tmp on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Live map server location (optional)
NEXT_PUBLIC_SERVER_LAT=39.5
NEXT_PUBLIC_SERVER_LON=-98.35

# Phase 3 (users/auth)
NEXT_PUBLIC_SITE_URL=https://your-domain  # WebAuthn RP id/origin in prod (required for passkeys)
BLOB_READ_WRITE_TOKEN=                    # avatar/banner uploads via Vercel Blob (optional)
